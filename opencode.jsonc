{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-4-5",
  "plugin": [
    "@franlol/opencode-md-table-formatter",
    "@nick-vi/opencode-type-inject",
    "@plannotator/opencode",
    "@tarquinen/opencode-dcp",
    "oh-my-opencode",
    "opencode-wakatime",
  ],
  "formatter": {
    "prettier": {
      "command": [
        "pnpm",
        "prettier",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".json",
        ".css",
        ".md"
      ]
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "**/dist/**",
      "**/build/**"
    ]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "/Users/slavoie2/.config/opencode/mcp/playwright.sh"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "/Users/slavoie2/.config/opencode/mcp/context7.sh"
      ],
      "enabled": true
    },
    "atlassian": {
      "type": "local",
      "command": [
        "/Users/slavoie2/.config/opencode/mcp/atlassian.sh"
      ],
      "enabled": true
    },
    "slack": {
      "enabled": true,
      "type": "local",
      "command": [
        "/Users/slavoie2/.config/opencode/mcp/slack.sh"
      ]
    },
    "gdrive": {
      "type": "local",
      "command": [
        "/Users/slavoie2/.config/opencode/mcp/gdrive.sh"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "/Users/slavoie2/.config/opencode/mcp/github.sh"
      ],
      "enabled": true
    }
  },
  "instructions": [
    "/Users/slavoie2/.config/opencode/INSTRUCTIONS.md",
    ".cursor/rules/*.md"
  ],
  "provider": {
    "google": {
      "name": "Google",
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "minimal": {
              "thinkingLevel": "minimal"
            },
            "low": {
              "thinkingLevel": "low"
            },
            "medium": {
              "thinkingLevel": "medium"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5 (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "antigravity-claude-sonnet-4-5-thinking": {
          "name": "Claude Sonnet 4.5 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "antigravity-claude-opus-4-5-thinking": {
          "name": "Claude Opus 4.5 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        }
      }
    }
  }
}
